# =============================================================
# RuralBus Environment Configuration Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================

# --- Database ---
DATABASE_URL=postgresql://ruralbus_app:app_secure_password@localhost:5432/ruralbus

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- JWT ---
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_RANDOM_64_BYTE_HEX
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d

# --- Server ---
PORT=4000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# --- Payments (mock for dev) ---
PAYMENTS_MODE=mock
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# --- Maps (mock for dev) ---
MAP_PROVIDER=mock

# --- Web Admin URL (for CORS) ---
ADMIN_WEB_URL=http://localhost:5173
